<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="testing/bootstrap.php"
         colors="true"
         defaultTestSuite="OGame Open Source Test Suite">

    <testsuites>
        <testsuite name="OGame Open Source Test Suite">
            <directory>testing</directory>
        </testsuite>
        <testsuite name="Golden Pages">
            <file>testing/GoldenPagesTest.php</file>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">testing</directory>
        </include>
    </source>

    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
    </php>

</phpunit>
